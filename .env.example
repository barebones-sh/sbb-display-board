# Required by `npm run server` (server/index.ts) — powers the disruption
# banner via opentransportdata.swiss's SIRI-SX API. See docs/DATA.md's
# "Live disruption feed (SIRI-SX)" section for why there are two separate
# keys: siri-sx and siri-sx-unplanned are different API products in
# api-manager.opentransportdata.swiss, each with its own key.
#
# Without these set, `npm run server` refuses to start — but `npm run dev`
# (the stationboard itself) works fine without it; the banner just never
# appears.
OTD_API_KEY_SIRI_SX=
OTD_API_KEY_SIRI_SX_UNPLANNED=
